# Salin ke .env.local lalu isi. Asal tiap nilai tertulis di komentar.

# --- 01-supabase (Settings -> API) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=            # rahasia, hanya server

# --- 02-google-gmail ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=                 # dari get-refresh-token.mjs
GMAIL_MAILBOX=sales@yourcompany.com
GMAIL_INTAKE_QUERY=                   # opsional, contoh: to:sales@yourcompany.com

# --- 03-inngest (production saja; kosongkan di lokal) ---
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=


# --- 04-ai-llm: pilih salah satu provider ---
# Gemini (gratis, tanpa kartu kredit): kunci dari https://aistudio.google.com
GEMINI_API_KEY=                       # rahasia, hanya server
GEMINI_MODEL=                         # opsional, default gemini-flash-latest
GEMINI_TIER=free                      # free | paid (hanya mengatur peringatan privasi di UI)
AI_MAX_RPM=5                          # batas per menit untuk tiap fungsi AI (analisis inquiry dan parsing balasan); total maks. 2x
# Anthropic (berbayar), opsional:
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=                      # opsional, default claude-sonnet-5-5
AI_PROVIDER=                          # kosong = otomatis; atau gemini | anthropic
AI_CONFIDENCE_THRESHOLD=0.8           # ambang keyakinan (0-1)

# --- Bahasa email task ke departemen: id | en | both ---
EMAIL_LANG=id

# --- Phase 3: departemen dan SLA ---
TASK_AUTO_SUBMIT=true                 # true: balasan valid dan yakin otomatis menjadikan task SUBMITTED; false: semua masuk review
APP_URL=                              # opsional, mis. https://workzen.perusahaan.com; dipakai untuk tautan di email eskalasi
